{
  "name": "cascade",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "tunnel": "ngrok http 3001",
    "osrm:up": "docker run --rm -p 5000:5000 -v $(pwd)/server/osrm-data:/data osrm/osrm-backend osrm-routed /data/region.osrm"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
